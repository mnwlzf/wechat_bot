<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
      消息检测日志：每检测到一条消息写一行「群聊/私聊 + 会话 ID + 发送者 + 处理结果 + 内容」。
      单独一份文件，方便直接 Get-Content -Wait 盯着看，照着里面的群号 / wxid 加白名单。
    -->
    <property name="INBOUND_LOG_FILE" value="${INBOUND_LOG_FILE:-logs/inbound.log}"/>

    <appender name="INBOUND_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${INBOUND_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${INBOUND_LOG_FILE}.%d{yyyy-MM-dd}</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="wechat.inbound" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="INBOUND_FILE"/>
    </logger>

    <!--
      原始回调报文：每条回调一行原文（含图片/语音 XML），排查语音为什么拿不到音频、
      图片 md5 长什么样这类问题用；不用时把 WECHAT_HOOK_RAW_LOG 设成 false 即可。
    -->
    <property name="HOOK_RAW_LOG_FILE" value="${HOOK_RAW_LOG_FILE:-logs/hook-raw.log}"/>

    <appender name="HOOK_RAW_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${HOOK_RAW_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${HOOK_RAW_LOG_FILE}.%d{yyyy-MM-dd}</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="wechat.hook.raw" level="INFO" additivity="false">
        <appender-ref ref="HOOK_RAW_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
