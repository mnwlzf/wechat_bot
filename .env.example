# =============================================================
# 环境变量模板 —— 本地调试请执行：Copy-Item .env.example .env
# 然后只在根目录 .env 中完善配置（后端 / Docker / 前端共用这一份）
#
# 说明：
#   - 空值 = 不注入，使用 application.yml / vite.config.ts 的内置默认值
#   - 不要把真实密钥提交到仓库；.env 已被 .gitignore 忽略
# =============================================================

# ---------- PostgreSQL ----------
# JDBC 连接串由 主机 + 端口 + 库名 自动拼装，无需手写
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=wechat_bot
POSTGRES_USER=wechat
POSTGRES_PASSWORD=change-me-postgres

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 6+ ACL 用户名；留空 = 仅密码认证
REDIS_USERNAME=
REDIS_PASSWORD=change-me-redis
# 库号（0-15），默认 0
REDIS_DATABASE=0

# ---------- 后端服务 ----------
SERVER_PORT=8080
ADMIN_TOKEN=change-me-admin-token
AGENT_TOKEN=change-me-agent-token
APP_SECRET_KEY=replace-with-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 模型 Provider（启动时按环境变量写入数据库）----------
# 留空 LLM_BASE_URL / LLM_MODEL 即跳过，改用管理端配置的 provider。
# overwrite=true：每次启动用这里覆盖同名 provider；false：只补空字段。
LLM_BOOTSTRAP_ENABLED=true
LLM_BOOTSTRAP_OVERWRITE=true
LLM_BOOTSTRAP_ASSIGN_TO_BOT=true
# 备用链路（多 Provider 回退）默认值；管理端“运行策略”可实时覆盖
LLM_FALLBACK_ENABLED=true
LLM_NAME=deepseek
# Base URL 末尾不需要 /chat/completions；只填域名会自动补 /v1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BACKUP_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PRIORITY=10
LLM_TIMEOUT_SECONDS=60
# 可选备用通道：主通道失败时按 priority 回退
LLM_FALLBACK_NAME=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BACKUP_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRIORITY=20
LLM_FALLBACK_TIMEOUT_SECONDS=60

# DeepSeek 官方联网搜索（POST https://api.deepseek.com/v1/tools/search）
# mode: OFF 关闭 / HEURISTIC 按关键词判断 / ALWAYS 每条消息都搜
# 搜索 Key 与聊天模型 Key 完全独立；未配置搜索 Key 时不会回退到模型 Key
LLM_SEARCH_ENABLED=true
LLM_SEARCH_MODE=HEURISTIC
LLM_SEARCH_BASE_URL=https://api.deepseek.com
LLM_SEARCH_API_KEY=
LLM_SEARCH_BACKUP_API_KEY=
LLM_SEARCH_COUNT=5
LLM_SEARCH_NEED_CONTENT=false
LLM_SEARCH_MAX_RESULTS=4
LLM_SEARCH_MAX_CONTENT_CHARS=1200
LLM_SEARCH_TIMEOUT_SECONDS=20

# 图片识别（视觉输入）：把微信图片解码成 JPEG 后随消息一起发给模型
# 需要主/副链路的模型本身支持图片输入；不支持时会自动降级为纯文本重试
LLM_VISION_ENABLED=true
LLM_VISION_MAX_EDGE=1024
LLM_VISION_MAX_BYTES=1500000
LLM_VISION_CACHE_DIR=data/media
# 微信本地图片密钥目录（kvcomm）；留空自动取 %APPDATA%\Tencent\xwechat\net\kvcomm
LLM_VISION_KVCOMM_DIR=
# 本地 .dat 文件名用的 md5 不稳定，对不上时按「同会话 + 消息时间窗口」兜底匹配
LLM_VISION_MATCH_WINDOW_SECONDS=180
# 微信数据目录（xwechat_files 的父级）；留空自动取 %USERPROFILE%\Documents\xwechat_files
WECHAT_IMAGE_ROOT=

# ---------- 共享长期记忆（群内所有成员共用一份）----------
# 上下文窗口只带最近 N 条消息，滚出窗口的历史会被压成滚动摘要，再叠加人工要点一起注入提示词
MEMORY_ENABLED=true
# 只生成摘要、不自动压缩时设为 false（人工要点仍然生效）
MEMORY_SUMMARY_ENABLED=true
# 新增多少条历史消息才触发一次自动摘要
# 实际阈值取 min(这里, max(4, context-window/4))：窗口外的消息一攒够就压缩，避免记忆真空期
MEMORY_TRIGGER_MESSAGES=24
# 生成摘要时保留多少条最近消息不进摘要；0 = 跟随机器人的 context-window
MEMORY_KEEP_RECENT=0
MEMORY_BATCH_LIMIT=200
MEMORY_MAX_SUMMARY_CHARS=600
# 注入提示词的人工要点条数上限与单条长度上限
MEMORY_MAX_NOTES=8
MEMORY_NOTE_MAX_CHARS=500
# 同一会话两次自动摘要之间的最小间隔（分钟）
MEMORY_MIN_INTERVAL_MINUTES=5
# 会话安静超过这么多分钟就补一次摘要（0 = 关掉按时间触发，只按条数压）
# 上午聊完就散、下午对方再回来问的对话，靠这一条才不会失忆
MEMORY_IDLE_MINUTES=30
# 后台补摘要的扫描间隔（毫秒）与每轮最多处理几个会话
MEMORY_SWEEP_INTERVAL_MS=300000
MEMORY_SWEEP_BATCH=20

# ---------- 提醒任务（等回执的定时催促）----------
# 聊天里说「每天六点提醒我打卡，没回就五分钟催一次」，机器人会建一个提醒任务：
# 到点开始催，每 N 分钟一次，对方回话（停止词或自然语言）就停，最多催 M 次。
# 只支持私聊：群里谁都能说话，提醒会变成广播，也判不清该谁回执。
REMINDER_ENABLED=true
# 允许在聊天里用自然语言建 / 停 / 查提醒
REMINDER_CREATE_IN_CHAT=true
# 回执是否允许让模型判断（「弄好了」「搞定了」也认）；关掉则只认停止词
REMINDER_NL_ACK=true
REMINDER_DEFAULT_INTERVAL_MINUTES=5
REMINDER_DEFAULT_MAX_TIMES=6
# 次数硬顶：聊天里说「提醒我一万次」也只能到这里
REMINDER_HARD_MAX_TIMES=20
# 间隔下限，防止刷屏
REMINDER_MIN_INTERVAL_MINUTES=5
# 单个私聊同时等待回执的提醒数上限 / 每天最多新建几个
REMINDER_MAX_WAITING_PER_CHAT=3
REMINDER_MAX_PER_DAY_PER_CHAT=5
# 次数用完时补一句「算了，我先不催了」
REMINDER_FINAL_MESSAGE=true
# 解析缺时间时追问的状态保留多久（秒）
REMINDER_ASK_BACK_SECONDS=300

# ---------- 群消息连发时的聚合（防复读机）----------
# 群里经常一秒好几条。开着的话：最后一条消息之后静默 REPLY_DEBOUNCE_SECONDS 才生成一次回复，
# 一次回复覆盖整段对话；期间来的新消息只是把等待重置。
REPLY_DEBOUNCE_ENABLED=true
REPLY_DEBOUNCE_SECONDS=3
# 刷屏的群不会一直等：从这串消息的第一条算起，攒满这么久就必须回一次（0 = 不封顶）
REPLY_MAX_WAIT_SECONDS=12
# 同时生成回复的会话数上限；同一个会话内部永远串行，不会两条回复抢跑
REPLY_WORKERS=4

# ---------- 让聊天对象自己挑人设 ----------
# 开着时：群里/私聊里发「换人设」，机器人只回一份人设名称列表，对方回数字就改绑这个会话并立刻生效。
# 列表里只有名称，不会把人设正文（system prompt）发给对方。不想开放就设成 false。
PERSONA_SWITCH_ENABLED=true
# 列完名单后等对方选编号的有效期（秒）；超时后按普通消息处理
PERSONA_PENDING_SECONDS=300

# ---------- 语音转文字（ASR）----------
# 收到语音消息 → 本地找语音文件 → SILK 转 WAV → 交给 ASR 接口 → 交给模型
# 默认对接阿里云百炼 qwen-audio-3.1-asr-flash（同步 HTTP，音频 base64 内联）
ASR_ENABLED=true
# bailian（默认）或 siliconflow（OpenAI 风格 /v1/audio/transcriptions）
ASR_PROVIDER=bailian
ASR_BASE_URL=https://dashscope.aliyuncs.com
# 留空则用 DASHSCOPE_API_KEY（一个 Key 同时管识别和合成）
ASR_API_KEY=
ASR_MODEL=qwen-audio-3.1-asr-flash
# 想换回硅基流动：ASR_PROVIDER=siliconflow / ASR_BASE_URL=https://api.siliconflow.cn
#   / ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra / ASR_API_KEY=sk-...
# 关掉后语音消息只显示时长（老行为）
ASR_TRANSCRIBE_VOICE=true
# 微信语音是 SILK，接口只收 wav/mp3，需要一个外部解码命令：
#   JSON 进 JSON 出：node D:\WeChatAgent-main\scripts\decode-wechat-voice.mjs
#   文件模式：ffmpeg -y -i {input} {output}
# 留空则自动探测 node + WeChatAgent 的解码脚本
ASR_SILK_DECODER=

# ---------- 微信 4.x 本地数据库（语音音频只在这里）----------
# 微信收到的语音没有落盘文件，音频在 db_storage/message/media_*.db 的 VoiceInfo.voice_data。
# 库是 SQLCipher 加密的，密钥与账号绑定（64 位 hex），换账号要重新取；留空 = 不读本地库。
# 取法：hooks 只读回调报文里的 msgid，用它去 VoiceInfo.svr_id 精确命中。
WECHAT_DB_ENABLED=true
WECHAT_DB_KEY=
# 微信数据目录；留空自动找 %USERPROFILE%\Documents\xwechat_files\*\db_storage
WECHAT_DB_DATA_DIR=

# ---------- 前端 / Vite（仅 VITE_ 前缀会进入浏览器端代码）----------
VITE_API_BASE_URL=
VITE_DEV_PORT=5173
# 开发服务器监听地址；默认只绑回环（127.0.0.1），需要局域网/真机访问时改成 0.0.0.0
VITE_DEV_HOST=127.0.0.1
VITE_PROXY_TARGET=

# ---------- 微信 Hook（微信 4.1.10.27 预编译 version.dll）----------
WECHAT_HOOK_ENABLED=true
WECHAT_HOOK_OUTBOX_ENABLED=true
WECHAT_HOOK_URL=http://127.0.0.1:30001
WECHAT_ACCOUNT=
# Comma-separated wxid / @chatroom ids. Groups are only accepted when listed here;
# an empty list accepts every private chat (when accept-all is on) but no group.
# 以下三项是默认值；管理端「运行策略」写入数据库后以数据库为准，改完立即生效
WECHAT_ALLOWED_CHATS=
# Your own wxid: used to drop messages the account sent itself (prevents reply loops).
WECHAT_SELF_WXID=
# Hook push mode (CallBackURL). Works even when the hook reports IsLogin=0.
WECHAT_HOOK_CALLBACK_ENABLED=true
# Accept every private chat while the private whitelist is empty.
# 公众号（gh_*）、机器人（*@weclaw / *@openim）和微信系统会话永远不会被回复。
WECHAT_CALLBACK_ACCEPT_ALL=true
WECHAT_CALLBACK_REQUIRE_LOOPBACK=true
WECHAT_CALLBACK_GROUPS_ENABLED=false
WECHAT_HOOK_SKIP_HISTORY=true
# 可选：外部联系人读取服务（WeChatAgent 的 WeFlow reader 同款 /api/v1/contacts），留空不用
WECHAT_READER_URL=
WECHAT_HOOK_POLL_INTERVAL_MS=2000
WECHAT_HOOK_INITIAL_DELAY_MS=5000
WECHAT_HOOK_OUTBOX_INTERVAL_MS=1000
WECHAT_HOOK_BATCH_SIZE=100
WECHAT_HOOK_CONNECT_TIMEOUT=2s
WECHAT_HOOK_READ_TIMEOUT=8s
# Optional: only needed by a custom auth-enabled overlay build. The official prebuilt DLL has no token auth.
WECHAT_HOOK_TOKEN=
WECHAT_HOOK_TOKEN_FILE=

# ---------- 拟人化伪装层 ----------
# 关闭后回复立即发送，只适合本地调试；长期运行必须保持开启
DISGUISE_ENABLED=true
DISGUISE_ZONE=Asia/Shanghai

# 睡眠与手动离线段
DISGUISE_QUIET_START=00:30
DISGUISE_QUIET_END=07:30
DISGUISE_MAX_DEFER_MINUTES=480
DISGUISE_SCHEDULE_ENABLED=true
# “离开手机”离线块独立开关；关闭后睡眠窗口仍正常生效
DISGUISE_AWAY_BLOCKS_ENABLED=true
# 每日手动离线块，格式 HH:mm-HH:mm，逗号分隔，最多 6 段，支持跨零点
DISGUISE_AWAY_BLOCKS=10:00-10:40,15:00-15:40

# ---------- 发信延迟 ----------
# 收到消息后的随机阅读延迟
DISGUISE_READ_DELAY_MIN_MS=1200
DISGUISE_READ_DELAY_MAX_MS=7000
# 基础思考时间；回复每字额外增加 9ms，最多 4.5 秒
DISGUISE_THINK_BASE_MS=500
# 平均打字速度与抖动
DISGUISE_CHARS_PER_SECOND=3.4
DISGUISE_TYPING_JITTER=0.30
# 单条拟人延迟上限；代码硬上限为 30000，配置更高也只会按 30 秒执行
DISGUISE_MAX_DELAY_MS=30000
# 第一条消息的硬上限（毫秒）：发送配额排队、打字延迟算出来的等待都不会超过它，默认 15 秒。
# 一天里被「每分钟 N 条」的配额挡住时，回复不会被拖到一分钟以后；作息/免打扰仍然可以往后推。
DISGUISE_MAX_FIRST_DELAY_MS=15000
# 长停顿概率与最长时长
DISGUISE_LONG_PAUSE_PROBABILITY=0.08
DISGUISE_LONG_PAUSE_MAX_MS=180000
# 随机离开手机概率与时长
DISGUISE_AWAY_PROBABILITY=0.02
DISGUISE_AWAY_MIN_MS=240000
DISGUISE_AWAY_MAX_MS=900000
# 群聊整体延迟系数
DISGUISE_GROUP_DELAY_FACTOR=1.35

# 分条
DISGUISE_SPLIT_ENABLED=true
DISGUISE_MAX_PARTS=3
DISGUISE_MAX_PART_CHARS=90
DISGUISE_MAX_REPLY_CHARS=420
DISGUISE_PART_GAP_MIN_MS=600
DISGUISE_PART_GAP_MAX_MS=2600

# ---------- 发信频率 ----------
# 单会话滚动窗口配额
DISGUISE_PER_MINUTE=3
DISGUISE_PER_10MIN=8
DISGUISE_PER_HOUR=20
DISGUISE_PER_DAY=120
# 账号级滚动窗口配额
DISGUISE_GLOBAL_PER_HOUR=40
# 账号级每日上限：0 = 不限（默认），只保留每小时上限；填正整数才启用每日封顶
DISGUISE_GLOBAL_PER_DAY=0
# 同会话相邻消息最小间隔
DISGUISE_MIN_GAP_MS=1200
# 连续发送后的强制休息
DISGUISE_BURST_SIZE=5
DISGUISE_BURST_COOLDOWN_MIN_MS=90000
DISGUISE_BURST_COOLDOWN_MAX_MS=420000

# ---------- 去重与文风 ----------
DISGUISE_SIMILARITY_THRESHOLD=0.62
DISGUISE_CROSS_SIMILARITY_THRESHOLD=0.92
DISGUISE_REGENERATE_ON_REPEAT=true
DISGUISE_STYLE_ENABLED=true
DISGUISE_EMOJI_LIMIT=1
DISGUISE_DROP_RATE=0.0
DISGUISE_PROMPT_ENABLED=true


# ---------- TTS: aliyun bailian qwen-audio-3.1-tts-flash (WebSocket duplex) ----------
# API key from https://bailian.console.aliyun.com ; empty = TTS disabled.
# Beijing: wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_API_KEY=
TTS_ENABLED=true
TTS_MODEL=qwen-audio-3.1-tts-flash
TTS_VOICE=longanhuan_v3.1
TTS_FORMAT=pcm
TTS_SAMPLE_RATE=24000