# =============================================================
# 环境变量模板 —— 本地调试请执行：Copy-Item .env.example .env
# 然后只在根目录 .env 中完善配置（后端 / Docker / 前端共用这一份）
#
# 说明：
#   - 空值 = 不注入，使用 application.yml / vite.config.ts 的内置默认值
#   - 不要把真实密钥提交到仓库；.env 已被 .gitignore 忽略
# =============================================================

# ---------- PostgreSQL ----------
# JDBC 连接串由 主机 + 端口 + 库名 自动拼装，无需手写
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=wechat_bot
POSTGRES_USER=wechat
POSTGRES_PASSWORD=change-me-postgres

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 6+ ACL 用户名；留空 = 仅密码认证
REDIS_USERNAME=
REDIS_PASSWORD=change-me-redis
# 库号（0-15），默认 0
REDIS_DATABASE=0

# ---------- 后端服务 ----------
SERVER_PORT=8080
ADMIN_TOKEN=change-me-admin-token
AGENT_TOKEN=change-me-agent-token
APP_SECRET_KEY=replace-with-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 模型 Provider（启动时按环境变量写入数据库）----------
# 留空 LLM_BASE_URL / LLM_MODEL 即跳过，改用管理端配置的 provider。
# overwrite=true：每次启动用这里覆盖同名 provider；false：只补空字段。
LLM_BOOTSTRAP_ENABLED=true
LLM_BOOTSTRAP_OVERWRITE=true
LLM_BOOTSTRAP_ASSIGN_TO_BOT=true
# 备用链路（多 Provider 回退）默认值；管理端“运行策略”可实时覆盖
LLM_FALLBACK_ENABLED=true
LLM_NAME=deepseek
# Base URL 末尾不需要 /chat/completions；只填域名会自动补 /v1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_BACKUP_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PRIORITY=10
LLM_TIMEOUT_SECONDS=60
# 可选备用通道：主通道失败时按 priority 回退
LLM_FALLBACK_NAME=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BACKUP_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRIORITY=20
LLM_FALLBACK_TIMEOUT_SECONDS=60

# DeepSeek 官方联网搜索（POST https://api.deepseek.com/v1/tools/search）
# mode: OFF 关闭 / HEURISTIC 按关键词判断 / ALWAYS 每条消息都搜
# 搜索 Key 与聊天模型 Key 完全独立；未配置搜索 Key 时不会回退到模型 Key
LLM_SEARCH_ENABLED=true
LLM_SEARCH_MODE=HEURISTIC
LLM_SEARCH_BASE_URL=https://api.deepseek.com
LLM_SEARCH_API_KEY=
LLM_SEARCH_BACKUP_API_KEY=
LLM_SEARCH_COUNT=5
LLM_SEARCH_NEED_CONTENT=false
LLM_SEARCH_MAX_RESULTS=4
LLM_SEARCH_MAX_CONTENT_CHARS=1200
LLM_SEARCH_TIMEOUT_SECONDS=20

# 图片识别（视觉输入）：把微信图片解码成 JPEG 后随消息一起发给模型
# 需要主/副链路的模型本身支持图片输入；不支持时会自动降级为纯文本重试
LLM_VISION_ENABLED=true
LLM_VISION_MAX_EDGE=1024
LLM_VISION_MAX_BYTES=1500000
LLM_VISION_CACHE_DIR=data/media
# 微信本地图片密钥目录（kvcomm）；留空自动取 %APPDATA%\Tencent\xwechat\net\kvcomm
LLM_VISION_KVCOMM_DIR=
# 本地 .dat 文件名用的 md5 不稳定，对不上时按「同会话 + 消息时间窗口」兜底匹配
LLM_VISION_MATCH_WINDOW_SECONDS=180
# 微信数据目录（xwechat_files 的父级）；留空自动取 %USERPROFILE%\Documents\xwechat_files
WECHAT_IMAGE_ROOT=

# ---------- 前端 / Vite（仅 VITE_ 前缀会进入浏览器端代码）----------
VITE_API_BASE_URL=
VITE_DEV_PORT=5173
# 开发服务器监听地址；默认只绑回环（127.0.0.1），需要局域网/真机访问时改成 0.0.0.0
VITE_DEV_HOST=127.0.0.1
VITE_PROXY_TARGET=

# ---------- 微信 Hook（微信 4.1.10.27 预编译 version.dll）----------
WECHAT_HOOK_ENABLED=true
WECHAT_HOOK_OUTBOX_ENABLED=true
WECHAT_HOOK_URL=http://127.0.0.1:30001
WECHAT_ACCOUNT=
# Comma-separated wxid / @chatroom ids. Empty means accept every chat when callback mode is on.
# 以下三项是默认值；管理端「运行策略」写入数据库后以数据库为准，改完立即生效
WECHAT_ALLOWED_CHATS=
# Your own wxid: used to drop messages the account sent itself (prevents reply loops).
WECHAT_SELF_WXID=
# Hook push mode (CallBackURL). Works even when the hook reports IsLogin=0.
WECHAT_HOOK_CALLBACK_ENABLED=true
WECHAT_CALLBACK_ACCEPT_ALL=true
WECHAT_CALLBACK_REQUIRE_LOOPBACK=true
WECHAT_CALLBACK_GROUPS_ENABLED=false
WECHAT_HOOK_SKIP_HISTORY=true
WECHAT_HOOK_POLL_INTERVAL_MS=2000
WECHAT_HOOK_INITIAL_DELAY_MS=5000
WECHAT_HOOK_OUTBOX_INTERVAL_MS=1000
WECHAT_HOOK_BATCH_SIZE=100
WECHAT_HOOK_CONNECT_TIMEOUT=2s
WECHAT_HOOK_READ_TIMEOUT=8s
# Optional: only needed by a custom auth-enabled overlay build. The official prebuilt DLL has no token auth.
WECHAT_HOOK_TOKEN=
WECHAT_HOOK_TOKEN_FILE=

# ---------- 拟人化伪装层 ----------
# 关闭后回复立即发送，只适合本地调试；长期运行必须保持开启
DISGUISE_ENABLED=true
DISGUISE_ZONE=Asia/Shanghai

# 睡眠与手动离线段
DISGUISE_QUIET_START=00:30
DISGUISE_QUIET_END=07:30
DISGUISE_MAX_DEFER_MINUTES=480
DISGUISE_SCHEDULE_ENABLED=true
# “离开手机”离线块独立开关；关闭后睡眠窗口仍正常生效
DISGUISE_AWAY_BLOCKS_ENABLED=true
# 每日手动离线块，格式 HH:mm-HH:mm，逗号分隔，最多 6 段，支持跨零点
DISGUISE_AWAY_BLOCKS=10:00-10:40,15:00-15:40

# ---------- 发信延迟 ----------
# 收到消息后的随机阅读延迟
DISGUISE_READ_DELAY_MIN_MS=1200
DISGUISE_READ_DELAY_MAX_MS=7000
# 基础思考时间；回复每字额外增加 9ms，最多 4.5 秒
DISGUISE_THINK_BASE_MS=500
# 平均打字速度与抖动
DISGUISE_CHARS_PER_SECOND=3.4
DISGUISE_TYPING_JITTER=0.30
# 单条拟人延迟硬上限
DISGUISE_MAX_DELAY_MS=90000
# 长停顿概率与最长时长
DISGUISE_LONG_PAUSE_PROBABILITY=0.08
DISGUISE_LONG_PAUSE_MAX_MS=180000
# 随机离开手机概率与时长
DISGUISE_AWAY_PROBABILITY=0.02
DISGUISE_AWAY_MIN_MS=240000
DISGUISE_AWAY_MAX_MS=900000
# 群聊整体延迟系数
DISGUISE_GROUP_DELAY_FACTOR=1.35

# 分条
DISGUISE_SPLIT_ENABLED=true
DISGUISE_MAX_PARTS=3
DISGUISE_MAX_PART_CHARS=90
DISGUISE_MAX_REPLY_CHARS=420
DISGUISE_PART_GAP_MIN_MS=600
DISGUISE_PART_GAP_MAX_MS=2600

# ---------- 发信频率 ----------
# 单会话滚动窗口配额
DISGUISE_PER_MINUTE=3
DISGUISE_PER_10MIN=8
DISGUISE_PER_HOUR=20
DISGUISE_PER_DAY=120
# 账号级滚动窗口配额
DISGUISE_GLOBAL_PER_HOUR=40
DISGUISE_GLOBAL_PER_DAY=220
# 同会话相邻消息最小间隔
DISGUISE_MIN_GAP_MS=1200
# 连续发送后的强制休息
DISGUISE_BURST_SIZE=5
DISGUISE_BURST_COOLDOWN_MIN_MS=90000
DISGUISE_BURST_COOLDOWN_MAX_MS=420000

# ---------- 去重与文风 ----------
DISGUISE_SIMILARITY_THRESHOLD=0.62
DISGUISE_CROSS_SIMILARITY_THRESHOLD=0.92
DISGUISE_REGENERATE_ON_REPEAT=true
DISGUISE_STYLE_ENABLED=true
DISGUISE_EMOJI_LIMIT=1
DISGUISE_DROP_RATE=0.0
DISGUISE_PROMPT_ENABLED=true

